<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<APIProxy name="oauth">
  <DisplayName>Data Commons OAuth &amp; MCP Proxy</DisplayName>
  <Description>OAuth 2.0 Authorization Server facade and OAuth-protected MCP proxy</Description>
  <BasePaths>/api/oauth</BasePaths>
  <Policies>
    <Policy>add-cors</Policy>
    <Policy>set-southbound-key</Policy>
    <Policy>oauth-set-config</Policy>
    <Policy>oauth-return-as-metadata</Policy>
    <Policy>oauth-return-resource-metadata</Policy>
    <Policy>oauth-verify-client-id</Policy>
    <Policy>oauth-validate-authorize</Policy>
    <Policy>oauth-generate-state2-code</Policy>
    <Policy>oauth-redirect-to-google</Policy>
    <Policy>oauth-get-state2-attributes</Policy>
    <Policy>oauth-validate-callback</Policy>
    <Policy>oauth-delete-state2-code</Policy>
    <Policy>oauth-build-google-token-request</Policy>
    <Policy>oauth-call-google-token</Policy>
    <Policy>oauth-extract-google-id-token</Policy>
    <Policy>oauth-verify-google-id-token</Policy>
    <Policy>oauth-compute-uid</Policy>
    <Policy>oauth-generate-auth-code</Policy>
    <Policy>oauth-redirect-to-app</Policy>
    <Policy>oauth-decode-basic-auth</Policy>
    <Policy>oauth-normalize-basic-auth</Policy>
    <Policy>oauth-verify-client-form</Policy>
    <Policy>oauth-get-code-attributes</Policy>
    <Policy>oauth-verify-client-and-pkce</Policy>
    <Policy>oauth-generate-access-token</Policy>
    <Policy>oauth-refresh-access-token</Policy>
    <Policy>oauth-revoke-token</Policy>
    <Policy>oauth-return-revoke-ok</Policy>
    <Policy>oauth-verify-access-token</Policy>
    <Policy>oauth-enforce-user-quota</Policy>
    <Policy>oauth-strip-auth-headers</Policy>
    <Policy>oauth-raise-bad-request</Policy>
    <Policy>oauth-raise-invalid-client</Policy>
    <Policy>oauth-raise-invalid-grant</Policy>
    <Policy>oauth-raise-not-found</Policy>
    <Policy>oauth-rewrite-unauthorized-mcp</Policy>
    <Policy>oauth-rewrite-quota-exceeded</Policy>
    <Policy>oauth-rewrite-invalid-client</Policy>
    <Policy>oauth-rewrite-invalid-grant</Policy>
  </Policies>
  <ProxyEndpoints>
    <ProxyEndpoint>oauth</ProxyEndpoint>
  </ProxyEndpoints>
  <TargetEndpoints>
    <TargetEndpoint>oauth</TargetEndpoint>
  </TargetEndpoints>
  <Resources>
    <Resource>jsc://oauth-validate-authorize.js</Resource>
    <Resource>jsc://oauth-validate-callback.js</Resource>
    <Resource>jsc://oauth-verify-client-and-pkce.js</Resource>
  </Resources>
</APIProxy>
