<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="api">
  <Description />
  <FaultRules />
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>add-cors</Name>
      </Step>
    </Request>
    <Response />
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request />
    <Response />
  </PostFlow>
  <Flows />
  <HTTPProxyConnection>
    <BasePath>/api</BasePath>
    <Properties>
      <Property name="response.streaming.enabled">true</Property>
      <!-- Proxy-level cap. The api target (55s default read timeout, 300s api.timeout) and ESP (300s) enforce lower limits. -->
      <Property name="api.timeout">86400000</Property>
    </Properties>
    <VirtualHost>default</VirtualHost>
  </HTTPProxyConnection>
  <RouteRule name="api">
    <TargetEndpoint>api</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
