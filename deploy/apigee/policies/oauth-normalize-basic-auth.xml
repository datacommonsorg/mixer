<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="oauth-normalize-basic-auth">
  <DisplayName>oauth-normalize-basic-auth</DisplayName>
  <Remove>
    <Headers>
      <Header name="Authorization"/>
    </Headers>
  </Remove>
  <Set>
    <FormParams>
      <FormParam name="client_id">{oauth.basic.client_id}</FormParam>
      <FormParam name="client_secret">{oauth.basic.client_secret}</FormParam>
    </FormParams>
  </Set>
  <IgnoreUnresolvedVariables>false</IgnoreUnresolvedVariables>
  <AssignTo createNew="false" type="request"/>
</AssignMessage>
