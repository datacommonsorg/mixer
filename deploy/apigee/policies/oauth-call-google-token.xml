<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ServiceCallout continueOnError="false" enabled="true" name="oauth-call-google-token">
  <DisplayName>oauth-call-google-token</DisplayName>
  <Request clearPayload="false" variable="googleTokenRequest"/>
  <Response>googleTokenResponse</Response>
  <Timeout>10000</Timeout>
  <HTTPTargetConnection>
    <URL>https://oauth2.googleapis.com/token</URL>
    <SSLInfo>
      <Enabled>true</Enabled>
    </SSLInfo>
  </HTTPTargetConnection>
</ServiceCallout>
