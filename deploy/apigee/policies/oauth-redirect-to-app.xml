<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="oauth-redirect-to-app">
  <DisplayName>oauth-redirect-to-app</DisplayName>
  <Set>
    <Headers>
      <Header name="Location">{oauth.callback.redirect_uri}?code={oauthv2authcode.oauth-generate-auth-code.code}&amp;state={oauth.callback.encoded_state1}</Header>
      <Header name="Set-Cookie">dc_oauth_state=; HttpOnly; Secure; SameSite=Lax; Path=/oauth/callback; Max-Age=0</Header>
      <Header name="Cache-Control">no-store</Header>
    </Headers>
    <StatusCode>302</StatusCode>
    <ReasonPhrase>Found</ReasonPhrase>
  </Set>
  <IgnoreUnresolvedVariables>false</IgnoreUnresolvedVariables>
  <AssignTo createNew="false" type="response"/>
</AssignMessage>
