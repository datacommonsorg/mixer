<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="oauth-redirect-to-google">
  <DisplayName>oauth-redirect-to-google</DisplayName>
  <Set>
    <Headers>
      <Header name="Location">https://accounts.google.com/o/oauth2/v2/auth?client_id={private.oauth.google_client_id}&amp;redirect_uri=https://{oauth.public_hostname}/oauth/callback&amp;response_type=code&amp;scope=openid&amp;state={oauthv2authcode.oauth-generate-state2-code.code}</Header>
      <Header name="Set-Cookie">dc_oauth_state={oauth.authorize.csrf_nonce}; HttpOnly; Secure; SameSite=Lax; Path=/oauth/callback; Max-Age=600</Header>
      <Header name="Cache-Control">no-store</Header>
    </Headers>
    <StatusCode>302</StatusCode>
    <ReasonPhrase>Found</ReasonPhrase>
  </Set>
  <IgnoreUnresolvedVariables>false</IgnoreUnresolvedVariables>
  <AssignTo createNew="false" type="response"/>
</AssignMessage>
