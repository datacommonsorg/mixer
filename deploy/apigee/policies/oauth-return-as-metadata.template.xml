<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="oauth-return-as-metadata">
  <DisplayName>oauth-return-as-metadata</DisplayName>
  <Set>
    <Headers>
      <Header name="Cache-Control">public, max-age=300</Header>
    </Headers>
    <Payload contentType="application/json">{
  "issuer": "https://REPLACE_WITH_OAUTH_PUBLIC_HOSTNAME/oauth",
  "authorization_endpoint": "https://REPLACE_WITH_OAUTH_PUBLIC_HOSTNAME/oauth/authorize",
  "token_endpoint": "https://REPLACE_WITH_OAUTH_PUBLIC_HOSTNAME/oauth/token",
  "revocation_endpoint": "https://REPLACE_WITH_OAUTH_PUBLIC_HOSTNAME/oauth/revoke",
  "response_types_supported": ["code"],
  "grant_types_supported": ["authorization_code", "refresh_token"],
  "token_endpoint_auth_methods_supported": ["client_secret_basic", "client_secret_post"],
  "revocation_endpoint_auth_methods_supported": ["client_secret_basic", "client_secret_post"],
  "code_challenge_methods_supported": ["S256"],
  "scopes_supported": ["mcp"]
}</Payload>
    <StatusCode>200</StatusCode>
    <ReasonPhrase>OK</ReasonPhrase>
  </Set>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <AssignTo createNew="false" type="response"/>
</AssignMessage>
