<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OAuthV2 continueOnError="false" enabled="true" name="oauth-generate-access-token">
  <DisplayName>oauth-generate-access-token</DisplayName>
  <ExternalAuthorization>false</ExternalAuthorization>
  <Operation>GenerateAccessToken</Operation>
  <ExpiresIn>3600000</ExpiresIn>
  <RefreshTokenExpiresIn>31536000000</RefreshTokenExpiresIn>
  <SupportedGrantTypes>
    <GrantType>authorization_code</GrantType>
  </SupportedGrantTypes>
  <GrantType>request.formparam.grant_type</GrantType>
  <ClientId>request.formparam.client_id</ClientId>
  <Code>request.formparam.code</Code>
  <RedirectUri>request.formparam.redirect_uri</RedirectUri>
  <AppEndUser>oauthv2authcode.oauth-get-code-attributes.uid</AppEndUser>
  <RFCCompliantRequestResponse>true</RFCCompliantRequestResponse>
  <GenerateResponse enabled="true"/>
  <Attributes>
    <Attribute name="uid" ref="oauthv2authcode.oauth-get-code-attributes.uid" display="false"/>
  </Attributes>
</OAuthV2>
