MIXER_API_INTERNAL_KEY=<Valid API key for Mixer API Cloud Endpoints service>
MIXER_API_ESP_HOSTNAME=<Public hostname (domain) of Mixer API Cloud Endpoints service>
NL_PSC_IP=<Host IP of Private Service Connect service attachment for NL API>
TRIAL_API_KEY=<API key for Mixer API on Apigee that will have quota limits applied>
TRIAL_KEY_QUOTA_REQUESTS_PER_INTERVAL=<Quota limit to apply to trial key>
TRIAL_KEY_QUOTA_INTERVAL_MINUTES=<Length of quota interval for trial key in minutes>
API_PORTAL_URL=<Link to where to register to get a non-trial API key>
DEPLOYMENT_SERVICE_ACCOUNT=<Service Account email for Apigee deployment>
OAUTH_PUBLIC_HOSTNAME=<Public hostname for OAuth proxy, e.g. staging.api.datacommons.org>
GOOGLE_OAUTH_CLIENT_ID=<Google Sign-In OAuth 2.0 Web Client ID>
GOOGLE_OAUTH_CLIENT_SECRET=<Google Sign-In OAuth 2.0 Web Client Secret>
OAUTH_UID_HMAC_KEY=<Random 256-bit secret key used to HMAC-SHA256 Google sub into pseudonymous uid>
OAUTH_USER_QUOTA_REQUESTS_PER_INTERVAL=<Per-user rolling window quota request limit for OAuth MCP>
OAUTH_USER_QUOTA_INTERVAL_MINUTES=<Length of per-user rolling window quota interval in minutes>
