<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="oauth">
  <Description>Southbound ESP Target for OAuth-protected MCP endpoint</Description>
  <FaultRules/>
  <PreFlow name="PreFlow">
    <Request/>
    <Response/>
  </PreFlow>
  <Flows/>
  <PostFlow name="PostFlow">
    <Request>
      <Step>
        <Name>oauth-strip-auth-headers</Name>
      </Step>
      <Step>
        <Name>set-southbound-key</Name>
      </Step>
    </Request>
    <Response/>
  </PostFlow>
  <HTTPTargetConnection>
    <Properties>
      <Property name="response.streaming.enabled">true</Property>
      <!-- 5 minutes for MCP calls -->
      <Property name="api.timeout">300000</Property>
    </Properties>
    <URL>https://REPLACE_WITH_MIXER_API_ESP_HOSTNAME</URL>
    <SSLInfo>
      <Enabled>true</Enabled>
    </SSLInfo>
  </HTTPTargetConnection>
</TargetEndpoint>
